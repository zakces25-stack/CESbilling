# ═════════════════════════════════════════════════════════════════════════
# CES Billing Portal — Apache config for IONOS Deploy Now
# Sets Cache-Control headers so both browsers and Cloudflare cache files
# correctly. Also enables Gzip + a couple of small performance wins.
# ═════════════════════════════════════════════════════════════════════════

# ───── 1. Cache-Control headers ────────────────────────────────────────
# Per-file-type cache policy. Cloudflare reads these and respects them
# at the edge. Browsers cache locally for the same durations.
<IfModule mod_headers.c>

  # HTML — short cache so updates roll out quickly when you push to GitHub.
  # 5 minutes at edge + browser.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # Favicons + manifest — these change rarely. 30 days.
  <FilesMatch "\.(ico|webmanifest)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # Images, fonts — long cache. 30 days.
  <FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=2592000, immutable"
  </FilesMatch>

  # ───── CSS + JS — REVALIDATE. Read this before changing it back. ─────
  #
  # This used to be "public, max-age=2592000, immutable" and that was simply wrong for
  # this site. `immutable` is a promise to the browser that the bytes at this URL will
  # NEVER change, and it is only safe when the filename carries a content hash
  # (app.a1b2c3.js). Nothing here does. Every deploy overwrites these filenames in place,
  # so the rule was telling browsers not to bother re-checking a file that had in fact
  # changed — and `immutable` specifically licenses them to skip revalidation entirely.
  #
  # It bit twice, and both times cost hours:
  #   flex-shared.js       reached the trading desk on deploy and the customer weeks
  #                        later, which is the exact drift that file exists to prevent.
  #   pricing-parsers.js   four new supplier parsers went live, pricing.html picked them
  #                        up in five minutes (HTML is 300s above), and the desk still got
  #                        "no parser called ecotricity" for a month's worth of edge cache.
  #                        Then the EDF selling-days fix shipped and a re-upload was still
  #                        parsed by the stale file, writing wrong rates into the database.
  #
  # Each time the fix was a per-file override, which someone has to remember to add for
  # every new shared file. That is not a policy, it is a standing trap. So the DEFAULT is
  # now revalidation and no file needs an override again.
  #
  # What it costs: one conditional request per file per page load, answered with a 304 and
  # no body. The whole site serves THREE js files and no css at all —
  # pricing-parsers.js (100KB), flex-shared.js (40KB), sales-sw.js (4KB) — and all three
  # need revalidating anyway. The immutable rule was protecting nothing.
  #
  # If a genuinely static, versioned library is ever added, give THAT file a long-cache
  # override here. Do not invert this default again.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # PDFs (e.g. privacy policy) — 1 day. Long enough to ease load, short
  # enough that policy updates aren't stuck for weeks.
  <FilesMatch "\.pdf$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>

  # Service worker — MUST override the 30-day .js rule above (last match
  # wins). If this file is ever cached, installed sales apps can never
  # receive an update: the browser re-fetches sales-sw.js to detect one.
  <FilesMatch "^sales-sw\.js$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  # Sales app manifest — 1 hour, not 30 days, so changes to the installed
  # app's identity (start_url, icons) roll out same-day.
  <FilesMatch "^sales\.webmanifest$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # Shared flex render core. flex.html and flexclient.html both load this file and the
  # whole point of it is that a change reaches both portals at the same moment, so it must
  # never be cached without revalidation. The .css|.js default above already does that —
  # this stays as a belt-and-braces marker so that if anyone ever restores a long-cache
  # default, THIS file is still safe and the flex portals do not silently drift apart.
  <FilesMatch "^flex-shared\.js$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>

  # Pricebook parsers. Same belt-and-braces reason as flex-shared above, and the stakes
  # here are money: a parser change decides what a RATE MEANS, so a stale copy does not
  # fail visibly, it writes plausible wrong prices into the database. pricing.html and
  # pricing-parsers.js also check each other's version at load time and refuse to parse on
  # a mismatch, so a stale file now says so instead of quietly mispricing.
  <FilesMatch "^pricing-parsers\.js$">
    Header set Cache-Control "no-cache, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ───── 1b. MIME type for web app manifests ─────────────────────────────
# Stock Apache doesn't map .webmanifest, so without this it ships as
# text/plain and the gzip rule for application/manifest+json never fires.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# ───── 2. Gzip compression ─────────────────────────────────────────────
# Compresses text-based assets before sending. Cloudflare will add Brotli
# on top of this when proxying, which is even better.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE text/javascript application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ───── 3. Security headers ─────────────────────────────────────────────
# CSP is already set inside index.html via a <meta> tag, so we don't repeat
# it here. These are belt-and-braces extras that defend against framing
# attacks and force HTTPS.
<IfModule mod_headers.c>
  # Block the page being framed inside a malicious site (clickjacking)
  Header set X-Frame-Options "SAMEORIGIN"

  # Forbid browsers from MIME-sniffing
  Header set X-Content-Type-Options "nosniff"

  # Tell browsers + intermediaries to only use HTTPS for billcesgb.com for
  # a year (HSTS). Safe because Let's Encrypt cert is in place.
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Restrict what's sent in the Referer header to third-party requests
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ───── 4. Pretty error pages (optional) ───────────────────────────────
# If a customer hits a missing path, send them to the portal root.
ErrorDocument 404 /
